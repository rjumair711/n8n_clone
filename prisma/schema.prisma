// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Test {
  id   Int    @id @default(autoincrement())
  name String
}

enum SubscriptionPlan {
  FREE
  BEGINNER
  INTERMEDIATE
  PRO
}

model User {
  id                     String           @id
  name                   String
  email                  String
  emailVerified          Boolean          @default(false)
  image                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  sessions               Session[]
  accounts               Account[]
  workflows              Workflow[]
  credentials            Credential[]
  apiKeys                ApiKey[]
  workflowFiles          WorkflowFile[]
  plan                   SubscriptionPlan @default(FREE)
  trialEndsAt            DateTime?
  workflowCount          Int              @default(0)
  executionsUsed         Int              @default(0)
  hasCompletedOnboarding Boolean          @default(false)
  // "Execution data retention": 7, 30 or 90 days
  executionRetentionDays Int              @default(30)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Credential {
  id        String         @id @default(cuid())
  name      String
  value     String // This will store the SMTP settings as a JSON string
  type      CredentialType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  Node      Node[]
}

enum CredentialType {
  OPENAI
  ANTHROPIC
  GEMINI
  SMTP
  GOOGLE_SHEETS
  GOOGLE_CALENDAR
  NOTION
  TELEGRAM
  GITHUB
  AIRTABLE
  POSTGRES
  WHATSAPP
  HTTP_BASIC_AUTH
  HTTP_HEADER_AUTH
  HTTP_BEARER_AUTH
  GOOGLE_OAUTH2
  OPENAI_COMPATIBLE
  TWILIO
  JIRA
  HUBSPOT
  MYSQL
  RESEND
  SENDGRID
  SALESFORCE
  SSH
  DEEPSEEK
  KIMI
  QWEN
}

model Workflow {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  executions  Execution[]
  active      Boolean      @default(false)
  // False for "Don't save node input/output": only status and errors are kept
  saveExecutionData Boolean @default(true)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes       Node[]
  connections Connection[]
  triggerStates TriggerState[]
}

enum NodeType {
  INITIAL
  MANUAL_TRIGGER
  SCHEDULE_TRIGGER
  HTTP_REQUEST
  STRIPE_TRIGGER
  GOOGLE_FORM_TRIGGER
  ANTHROPIC
  GEMINI
  OPENAI
  DISCORD
  SLACK
  FILTER
  SET_VARIABLE
  DELAY
  WEBHOOK_RESPONSE
  EMAIL_SEND
  GOOGLE_SHEETS
  CODE
  AI_AGENT
  BUFFER_MEMORY
  GOOGLE_CALENDAR
  NOTION
  TELEGRAM
  DATE_TIME
  TEXT_FORMATTER
  CALCULATOR
  SWITCH
  IF
  MERGE
  LOOP
  WEBHOOK_TRIGGER
  CHAT_TRIGGER
  GITHUB
  AIRTABLE
  POSTGRES
  WHATSAPP
  RESPOND_TO_WEBHOOK
  ERROR_TRIGGER
  STOP_AND_ERROR
  TELEGRAM_TRIGGER
  WHATSAPP_TRIGGER
  GMAIL
  SPLIT_OUT
  AGGREGATE
  SORT
  LIMIT
  REMOVE_DUPLICATES
  SUMMARIZE
  EXECUTE_WORKFLOW
  EXECUTE_WORKFLOW_TRIGGER
  CHAT_MODEL
  GMAIL_TRIGGER
  STRUCTURED_OUTPUT_PARSER
  TEXT_CLASSIFIER
  INFORMATION_EXTRACTOR
  VECTOR_STORE
  MCP_CLIENT_TOOL
  EDIT_FIELDS
  TWILIO
  JIRA
  HUBSPOT
  MYSQL
  RESEND
  SENDGRID
  TYPEFORM_TRIGGER
  RSS_READ
  RSS_FEED_TRIGGER
  GOOGLE_DRIVE
  PDF_GENERATOR
  CONVERT_TO_FILE
  EXTRACT_FROM_FILE
  SALESFORCE
  SSH
  DEEPSEEK
  KIMI
  QWEN
}

model Node {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name     String
  type     NodeType
  position Json
  data     Json     @default("{}")

  // New fields for Delay Node
  delayAmount Int? // For Delay Node
  delayUnit   String? // For Delay Node

  // New fields for Webhook Response Node
  responseMessage String? // For Webhook Response Node
  responseStatus  String? // For Webhook Response Node (success/error)

  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id])

  outputConnections Connection[] @relation("FromNode")
  inputConnections  Connection[] @relation("ToNode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Connection {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromNodeId String
  fromNode   Node   @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)

  toNodeId String
  toNode   Node   @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  fromOutput String @default("main")
  toInput    String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Execution {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status     ExecutionStatus @default(RUNNING)
  error      String?         @db.Text
  errorStack String?         @db.Text

  inngestEventId String? @unique
  output         Json?

  // How the run was started: manual, manual-test, chat, schedule, webhook...
  triggerSource String?

  // Set by the Respond to Webhook node; the webhook route waits for it
  webhookResponse Json?

  // What the run started with, so it can be retried: the trigger node type
  // and the data that trigger received
  trigger   String?
  inputData Json?

  // Set when the retention cleanup removed this execution's data and node
  // logs and kept only the row
  dataDeletedAt DateTime?

  nodes ExecutionNode[]
}

model ExecutionNode {
  id String @id @default(cuid())

  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  nodeId   String
  nodeName String
  nodeType NodeType

  status ExecutionStatus @default(RUNNING)

  input  Json?
  output Json?

  error      String? @db.Text
  errorStack String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  @@index([executionId])
  @@index([nodeId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String // The unique ID for the chat session
  role      String // 'user', 'assistant', 'system', 'tool'
  content   String
  createdAt DateTime @default(now())

  // Index for fast retrieval based on the session
  @@index([sessionId])
}


model AgentMemory {
  id        String   @id @default(cuid())
  nodeId    String
  userId    String
  sessionId String?  // Optional fallback if no session context is provided
  role      String   // 'user', 'assistant'
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([nodeId])
  @@index([userId])
  @@index([sessionId])
  @@map("agent_memory")
}

// What a polling trigger (Gmail Trigger) has already seen. Kept outside the
// Node row because saving a workflow recreates its nodes.
model TriggerState {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeId     String   @unique
  state      Json     @default("{}")
  updatedAt  DateTime @updatedAt

  @@index([workflowId])
}

// One chunk of text and its embedding, written by the Vector Store node
model VectorDocument {
  id         String   @id @default(cuid())
  userId     String
  collection String
  content    String   @db.Text
  metadata   Json?
  embedding  Float[]
  createdAt  DateTime @default(now())

  @@index([userId, collection])
  @@map("vector_document")
}

// Keys for the public API (/api/v1). Only a hash of the key is stored.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // First characters of the key, shown in the list so keys can be told apart
  prefix     String
  keyHash    String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What the key may do; see src/lib/api-key-scopes.ts
  scopes     String[]  @default([])
  // The key stops working after this moment; null means it never expires
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("api_key")
}

// Fixed-window request counters for the public webhook and API routes
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@map("rate_limit")
}

// A file made or fetched by a workflow (a generated PDF, a download).
// Workflow data only carries a reference to it: { id, fileName, mimeType, size }.
model WorkflowFile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The run that created it, when there was one
  executionId String?
  fileName    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("workflow_file")
}

// One row per event a webhook or polling trigger has already accepted.
// Providers re-send events (Stripe, WhatsApp, Telegram...); the unique key
// makes the second delivery a no-op instead of a second run.
model WebhookDelivery {
  id          String   @id @default(cuid())
  workflowId  String
  // The trigger node type the event arrived at
  source      String
  // The provider's id for the event, or the caller's Idempotency-Key
  key         String
  executionId String?
  createdAt   DateTime @default(now())

  @@unique([workflowId, source, key])
  @@index([createdAt])
  @@map("webhook_delivery")
}

// A ready-made workflow published by an admin. Using one copies its nodes
// and connections into a new workflow of the user. Credentials and secrets
// are removed when the template is saved.
model WorkflowTemplate {
  id          String           @id @default(cuid())
  name        String
  description String           @db.Text
  category    String           @default("General")
  // The cheapest plan that may use it
  minPlan     SubscriptionPlan @default(FREE)
  // Hidden from the gallery while false
  published   Boolean          @default(true)
  // [{ id, type, position, data }] and [{ fromNodeId, toNodeId, fromOutput, toInput }]
  nodes       Json
  connections Json
  // The node types it contains, for the badges on its card
  nodeTypes   String[]
  useCount    Int              @default(0)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([published, category])
  @@map("workflow_template")
}
