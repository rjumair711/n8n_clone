// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Test {
  id   Int    @id @default(autoincrement())
  name String
}

enum SubscriptionPlan {
  FREE
  BEGINNER
  INTERMEDIATE
  PRO
}

model User {
  id                     String           @id
  name                   String
  email                  String
  emailVerified          Boolean          @default(false)
  image                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  sessions               Session[]
  accounts               Account[]
  workflows              Workflow[]
  credentials            Credential[]
  apiKeys                ApiKey[]
  workflowFiles          WorkflowFile[]
  plan                   SubscriptionPlan @default(FREE)
  trialEndsAt            DateTime?
  workflowCount          Int              @default(0)
  executionsUsed         Int              @default(0)
  hasCompletedOnboarding Boolean          @default(false)
  // "Execution data retention": 7, 30 or 90 days
  executionRetentionDays Int              @default(30)
  // Set by Better Auth's two-factor plugin once a code has been verified
  twoFactorEnabled       Boolean?         @default(false)
  twoFactors             TwoFactor[]
  messageUsage           MessageUsage[]
  auditLogs              AuditLog[]
  // Optional monthly AI budget in US cents, over all workflows. Null: none
  aiBudgetCents          Int?
  aiUsage                AiUsage[]
  // Bought AI credits that are left, in US dollars (see src/lib/ai-credits.ts).
  // The plan's monthly allowance is not stored: it is the plan's number less
  // what the month's included calls cost.
  aiCreditBalanceUsd     Decimal          @default(0) @db.Decimal(18, 10)
  aiCreditPurchases      AiCreditPurchase[]
  memorySummaries        AgentMemorySummary[]
  contactFacts           ContactFact[]
  // The user's own workspace, and the workspaces the user is a member of
  workspace              Workspace?
  workspaceMemberships   WorkspaceMember[]

  @@unique([email])
  @@map("user")
}

// What an account did that matters for its security: credentials, API keys,
// workflow activation, templates, sign-ins and two-factor changes. Rows are
// only ever added (see src/lib/audit-log.ts). Never holds a secret.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "credential.created", "workflow.activated", "auth.sign_in"...
  action    String
  // What it was done to, for a person to read: `Credential "SMTP" (id)`
  target    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_log")
}

// One call to a language or embedding model made by a run: the tokens the
// provider reported and what they cost at the price set at that moment (see
// src/lib/ai-usage.ts). Kept after the execution's data is deleted, so the
// month's spend stays complete: workflowId and executionId are plain ids.
model AiUsage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflowId  String?
  executionId String?
  // The node that made the call: an AI Agent, a model node, a tool
  nodeId      String?
  nodeName    String?
  // "chat" or "embedding"
  kind        String   @default("chat")
  // "openai", "anthropic", "gemini", a Chat Model preset or "custom"
  provider    String
  model       String
  // Input tokens that were not read from the provider's cache
  inputTokens       Int @default(0)
  outputTokens      Int @default(0)
  // Input tokens read from the provider's cache
  cachedInputTokens Int @default(0)
  // US dollars. Null when the price table had no row for the model.
  costUsd     Decimal? @db.Decimal(18, 10)
  // True for a call made with the platform's key ("RXJ AI (included)"): its
  // cost was taken from the user's AI credits
  included    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([workflowId, createdAt])
  @@index([executionId])
  @@map("ai_usage")
}

// "RXJ AI (included)": a provider key of the platform that every user may
// use, paid with their AI credits. Set up by admins in Settings. One row
// per Chat Model provider preset; the key is encrypted like a credential.
model PlatformAiProvider {
  id        String   @id @default(cuid())
  // A provider of src/features/executions/lib/chat-model-providers.ts
  provider  String   @unique
  apiKey    String
  // The model IDs users may pick. Each needs a row in the price table.
  models    String[]
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("platform_ai_provider")
}

// A credit pack bought through Polar. One row per paid order: the order id
// is unique, so an event Polar sends twice adds the credits once.
model AiCreditPurchase {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  polarOrderId String   @unique
  productId    String
  // The value of the credits that were added, in US dollars
  amountUsd    Decimal  @db.Decimal(18, 10)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_credit_purchase")
}

// What a model costs, in US dollars per million tokens. Edited by admins
// in Settings. Provider and model are stored in lower case.
model ModelPrice {
  id              String   @id @default(cuid())
  provider        String
  model           String
  inputPerM       Decimal  @db.Decimal(12, 6)
  outputPerM      Decimal  @db.Decimal(12, 6)
  // Null: cached input is charged like other input
  cachedInputPerM Decimal? @db.Decimal(12, 6)
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([provider, model])
  @@map("model_price")
}

// How many messages a user sent on one day (UTC) through one channel
// ("email", "whatsapp", "twilio", "telegram"), for the daily caps of
// src/config/message-caps.ts
model MessageUsage {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel String
  day     DateTime @db.Date
  count   Int      @default(0)

  @@unique([userId, channel, day])
  @@map("message_usage")
}

// Better Auth's two-factor plugin: the TOTP secret and the backup codes of a
// user, both encrypted by the plugin
model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // False until the first code from the authenticator app is accepted
  verified    Boolean? @default(true)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Credential {
  id        String         @id @default(cuid())
  name      String
  value     String // This will store the SMTP settings as a JSON string
  type      CredentialType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  // The owner of the workspace the credential belongs to
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null only for a row made by code from before workspaces
  workspaceId String?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  Node      Node[]

  @@index([workspaceId])
}

enum CredentialType {
  OPENAI
  ANTHROPIC
  GEMINI
  SMTP
  GOOGLE_SHEETS
  GOOGLE_CALENDAR
  NOTION
  TELEGRAM
  GITHUB
  AIRTABLE
  POSTGRES
  WHATSAPP
  HTTP_BASIC_AUTH
  HTTP_HEADER_AUTH
  HTTP_BEARER_AUTH
  GOOGLE_OAUTH2
  OPENAI_COMPATIBLE
  TWILIO
  JIRA
  HUBSPOT
  MYSQL
  RESEND
  SENDGRID
  SALESFORCE
  SSH
  DEEPSEEK
  KIMI
  QWEN
  TAVILY
  BRAVE_SEARCH
  JINA_READER
  FIRECRAWL
  SHOPIFY
  WOOCOMMERCE
  FACEBOOK_PAGE
  INSTAGRAM
  COHERE
}

model Workflow {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  executions  Execution[]
  active      Boolean      @default(false)
  // False for "Don't save node input/output": only status and errors are kept
  saveExecutionData Boolean @default(true)
  // Optional monthly AI budget of this workflow in US cents. Null: none
  aiBudgetCents Int?
  // The owner of the workspace the workflow belongs to
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null only for a row made by code from before workspaces
  workspaceId String?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  nodes       Node[]
  connections Connection[]
  triggerStates TriggerState[]
  pinnedData  PinnedData[]
  versions    WorkflowVersion[]
  evalDatasets EvalDataset[]

  @@index([workspaceId])
}

// TEAMS (see src/lib/workspaces.ts)
// Every user has one workspace of their own, and can be a member of
// others. Workflows, credentials and everything that hangs off them belong
// to a workspace; the plan and its limits are the workspace owner's.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  workflows   Workflow[]
  credentials Credential[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // OWNER, ADMIN, EDITOR or VIEWER
  role        String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

// Someone asked to join, by email. It becomes a membership when the user
// with that address accepts it.
model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Lower case
  email       String
  // ADMIN, EDITOR or VIEWER
  role        String
  invitedById String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([email])
  @@map("workspace_invite")
}

// The workflow as it was after a save. One is added whenever the saved
// nodes or connections change; old ones are removed (see
// src/features/workflows/lib/versions.ts).
model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  // 1, 2, 3... within the workflow
  number     Int
  // [{ id, type, position, data, credentialId }] and
  // [{ fromNodeId, toNodeId, fromOutput, toInput }]
  nodes       Json
  connections Json
  // Of the two, to tell whether a save changed anything
  contentHash String
  // What changed since the version before: nodes added, removed, changed
  summary     Json
  // Set when the version was made by restoring an older one
  restoredFromNumber Int?
  createdAt  DateTime @default(now())

  @@unique([workflowId, number])
  @@index([workflowId, createdAt])
  @@map("workflow_version")
}

// AGENT EVALUATIONS (see src/features/evaluations)
// A set of test cases for one workflow, and how their results are scored.
model EvalDataset {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name       String
  // The trigger every row's run starts from: a NodeType such as CHAT_TRIGGER
  trigger    String
  // "exact", "contains", "json_schema" or "llm_judge"
  scorer     String
  // Which part of the run's result is scored, e.g. "agent.text". Empty: all of it
  outputPath String   @default("")
  // For rows without an expected value of their own: the JSON schema, or
  // the grading criteria of the LLM judge
  criteria   String?  @db.Text
  // The LLM judge's model: { credentialId, model, provider, baseUrl }
  judgeModel Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rows EvalRow[]
  runs EvalRun[]

  @@index([workflowId])
  @@map("eval_dataset")
}

model EvalRow {
  id        String      @id @default(cuid())
  datasetId String
  dataset   EvalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  position  Int
  // Text, or JSON for a trigger that takes fields
  input     String      @db.Text
  // The expected output, a JSON schema, or grading criteria, by scorer
  expected  String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([datasetId, position])
  @@map("eval_row")
}

// One pass of the workflow over a dataset
model EvalRun {
  id         String      @id @default(cuid())
  datasetId  String
  dataset    EvalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  // What the user called it: "gpt-4o-mini", "new prompt"
  label      String
  // RUNNING, SUCCESS, FAILED or CANCELLED
  status     String      @default("RUNNING")
  scorer     String
  // The workflow version the rows ran, and the models that answered
  // ("openai/gpt-4o-mini"), so two runs can be told apart
  workflowVersionNumber Int?
  models     Json?
  rowsTotal  Int         @default(0)
  rowsDone   Int         @default(0)
  rowsPassed Int         @default(0)
  // The average of the rows' scores, 0 to 1
  score      Float?
  // US dollars: what the workflow's own model calls cost, and the judge's
  costUsd      Decimal?  @db.Decimal(18, 10)
  judgeCostUsd Decimal?  @db.Decimal(18, 10)
  avgDurationMs Int?
  error      String?     @db.Text
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  results EvalResult[]

  @@index([datasetId, startedAt])
  @@map("eval_run")
}

// One row of a run. The row's input and expected value are copied, so a
// run stays readable after its dataset was edited.
model EvalResult {
  id       String  @id @default(cuid())
  runId    String
  run      EvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rowId    String?
  position Int
  input    String  @db.Text
  expected String? @db.Text
  // PENDING, SUCCESS (ran and was scored) or FAILED (the run or the judge failed)
  status   String  @default("PENDING")
  // What was scored, cut to a limit
  output   String? @db.Text
  // 0 to 1
  score    Float?
  passed   Boolean?
  // Why: what did not match, or the judge's words
  reason   String? @db.Text
  error    String? @db.Text
  executionId String?
  durationMs  Int?
  costUsd      Decimal? @db.Decimal(18, 10)
  judgeCostUsd Decimal? @db.Decimal(18, 10)
  createdAt DateTime @default(now())

  @@unique([runId, position])
  @@map("eval_result")
}

// A node's output kept from an earlier run. In test runs from the editor
// the node is not run: this data is used in its place.
model PinnedData {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  // Not a relation: saving a workflow in the editor recreates its nodes
  // under the same ids
  nodeId     String
  // What the node added to the workflow's data in that run (as it was
  // stored: with secrets redacted)
  data       Json
  // The execution it was taken from. It may have been deleted since.
  executionId String?
  createdAt  DateTime @default(now())

  @@unique([workflowId, nodeId])
  @@map("pinned_data")
}

