model Node {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name     String
  type     NodeType
  position Json
  data     Json     @default("{}")

  // New fields for Delay Node
  delayAmount Int? // For Delay Node
  delayUnit   String? // For Delay Node

  // New fields for Webhook Response Node
  responseMessage String? // For Webhook Response Node
  responseStatus  String? // For Webhook Response Node (success/error)

  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id])

  outputConnections Connection[] @relation("FromNode")
  inputConnections  Connection[] @relation("ToNode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Connection {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromNodeId String
  fromNode   Node   @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)

  toNodeId String
  toNode   Node   @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  fromOutput String @default("main")
  toInput    String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  // Paused by a Wait node until a time or a call to its resume URL
  WAITING
}

model Execution {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status     ExecutionStatus @default(RUNNING)
  error      String?         @db.Text
  errorStack String?         @db.Text

  inngestEventId String? @unique
  output         Json?

  // How the run was started: manual, manual-test, chat, schedule, webhook...
  triggerSource String?

  // Set by the Respond to Webhook node; the webhook route waits for it
  webhookResponse Json?

  // The version of the workflow that ran. The number is kept too, because
  // the version itself is removed after a while. Null: before versions.
  workflowVersionId     String?
  workflowVersionNumber Int?

  // What the run started with, so it can be retried: the trigger node type
  // and the data that trigger received
  trigger   String?
  inputData Json?

  // Set when the retention cleanup removed this execution's data and node
  // logs and kept only the row
  dataDeletedAt DateTime?

  // Set while the status is WAITING: what the Wait node waits for ("time" or
  // "webhook") and when the wait, or its timeout, ends
  waitingFor   String?
  waitingUntil DateTime?
  // For "form": the page that is shown and the node that waits for it
  waitingData  Json?

  nodes     ExecutionNode[]
  approvals ApprovalRequest[]
}

// A question put to a person while an execution waits: may this AI Agent
// tool call run, or (Send and Wait for Approval node) may the workflow go on
model ApprovalRequest {
  id String @id @default(cuid())

  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  // The workflow's owner, who can answer it in the app
  userId String
  // The AI Agent or approval node that asked
  nodeId String

  // "tool" or "node"
  kind    String
  // The tool's name, or the node's title
  title   String
  // The tool's arguments, or the node's message
  details Json?
  // "in_app", "email", "slack", "telegram" or "whatsapp"
  channel String

  // PENDING, then once: APPROVED, REJECTED, EXPIRED or CANCELLED
  status     String    @default("PENDING")
  expiresAt  DateTime
  decidedAt  DateTime?
  // "link" or "app"
  decidedVia String?

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([executionId])
}

model ExecutionNode {
  id String @id @default(cuid())

  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  nodeId   String
  nodeName String
  nodeType NodeType

  status ExecutionStatus @default(RUNNING)

  input  Json?
  output Json?

  // Set when the node was not run in this execution and its data came from
  // somewhere else: "pinned" (pinned data) or "saved" (an earlier run, in a
  // partial run). Null: the node ran.
  dataSource String?

  error      String? @db.Text
  errorStack String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  @@index([executionId])
  @@index([nodeId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String // The unique ID for the chat session
  role      String // 'user', 'assistant', 'system', 'tool'
  content   String
  createdAt DateTime @default(now())

  // Index for fast retrieval based on the session
  @@index([sessionId])
}


model AgentMemory {
  id        String   @id @default(cuid())
  nodeId    String
  userId    String
  sessionId String?  // Optional fallback if no session context is provided
  role      String   // 'user', 'assistant'
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([nodeId])
  @@index([userId])
  @@index([sessionId])
  // One session's messages in order, for the Postgres Memory node
  @@index([nodeId, userId, sessionId, createdAt])
  @@map("agent_memory")
}

// Postgres Memory: the running summary of a session's older messages
model AgentMemorySummary {
  id              String   @id @default(cuid())
  nodeId          String
  userId          String
  sessionId       String
  summary         String   @db.Text
  // Messages up to and including this time are in the summary
  summarizedUntil DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([nodeId, userId, sessionId])
  @@map("agent_memory_summary")
}

// Postgres Memory: long-term facts an agent keeps about a contact. They
// belong to the account, so every agent of the account that names the same
// contact sees them.
model ContactFact {
  id        String   @id @default(cuid())
  userId    String
  contactId String
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId, key])
  @@map("contact_fact")
}

// What a polling trigger (Gmail Trigger) has already seen. Kept outside the
// Node row because saving a workflow recreates its nodes.
model TriggerState {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeId     String   @unique
  state      Json     @default("{}")
  updatedAt  DateTime @updatedAt

  @@index([workflowId])
}

// One chunk of text and its embedding, written by the Vector Store node
model VectorDocument {
  id         String   @id @default(cuid())
  userId     String
  collection String
  content    String   @db.Text
  metadata   Json?
  embedding  Float[]
  // The same embedding as a pgvector value, when the database has the
  // extension. The ORM cannot read or write it: see src/lib/vector-search.ts
  embeddingVector Unsupported("vector")?
  // Where the chunk came from ("gdrive:<folder>:<file>", "doc:<id>"), a hash
  // of the document it was cut from, and what the source said about the
  // document's state. Null for chunks inserted without a Document ID.
  sourceId      String?
  contentHash   String?
  sourceVersion String?
  createdAt  DateTime @default(now())

  @@index([userId, collection])
  @@index([userId, collection, sourceId])
  @@map("vector_document")
}

// Keys for the public API (/api/v1). Only a hash of the key is stored.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // First characters of the key, shown in the list so keys can be told apart
  prefix     String
  keyHash    String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What the key may do; see src/lib/api-key-scopes.ts
  scopes     String[]  @default([])
  // The key stops working after this moment; null means it never expires
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("api_key")
}

// Fixed-window request counters for the public webhook and API routes
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@map("rate_limit")
}

// A file made or fetched by a workflow (a generated PDF, a download).
// Workflow data only carries a reference to it: { id, fileName, mimeType, size }.
model WorkflowFile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The run that created it, when there was one
  executionId String?
  fileName    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("workflow_file")
}

// One row per event a webhook or polling trigger has already accepted.
// Providers re-send events (Stripe, WhatsApp, Telegram...); the unique key
// makes the second delivery a no-op instead of a second run.
model WebhookDelivery {
  id          String   @id @default(cuid())
  workflowId  String
  // The trigger node type the event arrived at
  source      String
  // The provider's id for the event, or the caller's Idempotency-Key
  key         String
  executionId String?
  createdAt   DateTime @default(now())

  @@unique([workflowId, source, key])
  @@index([createdAt])
  @@map("webhook_delivery")
}

// A ready-made workflow published by an admin. Using one copies its nodes
// and connections into a new workflow of the user. Credentials and secrets
// are removed when the template is saved.
model WorkflowTemplate {
  id          String           @id @default(cuid())
  name        String
  description String           @db.Text
  category    String           @default("General")
  // The language its texts are written in: "en", "ur" or "ar" (see
  // src/features/templates/lib/template-languages.ts)
  language    String           @default("en")
  // The cheapest plan that may use it
  minPlan     SubscriptionPlan @default(FREE)
  // Hidden from the gallery while false
  published   Boolean          @default(true)
  // [{ id, type, position, data }] and [{ fromNodeId, toNodeId, fromOutput, toInput }]
  nodes       Json
  connections Json
  // The node types it contains, for the badges on its card
  nodeTypes   String[]
  useCount    Int              @default(0)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([published, category])
  @@map("workflow_template")
}
