{
  "key": "leave_and_expense_approval",
  "category": "Forms",
  "minPlan": "FREE",
  "nodes": [
    {
      "id": "form",
      "type": "FORM_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "formTitle": "@text:formTitle",
        "formDescription": "@text:formDescription",
        "formFields": "@text:formFields",
        "submitLabel": "@text:submitLabel",
        "afterSubmit": "message",
        "thankYouMessage": "@text:thankYouMessage",
        "captcha": "true"
      }
    },
    {
      "id": "approve",
      "type": "APPROVAL",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "variableName": "approval",
        "operation": "telegram",
        "title": "@text:approvalTitle",
        "message": "@text:approvalMessage",
        "recipient": "",
        "timeoutAmount": "2",
        "timeoutUnit": "days",
        "onTimeout": "reject"
      }
    },
    {
      "id": "approved",
      "type": "EMAIL_SEND",
      "position": {
        "x": 640,
        "y": -120
      },
      "data": {
        "recipient": "{{form.email}}",
        "subject": "@text:approvedSubject",
        "body": "@text:approvedBody"
      }
    },
    {
      "id": "rejected",
      "type": "EMAIL_SEND",
      "position": {
        "x": 640,
        "y": 160
      },
      "data": {
        "recipient": "{{form.email}}",
        "subject": "@text:rejectedSubject",
        "body": "@text:rejectedBody"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "form",
      "toNodeId": "approve",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "approve",
      "toNodeId": "approved",
      "fromOutput": "approved",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "approve",
      "toNodeId": "rejected",
      "fromOutput": "rejected",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "Leave and expense requests with Telegram approval",
      "description": "Staff request leave or an expense on a form; the manager approves or rejects it with one tap on Telegram, and the person gets the answer by email. Set up: pick your Telegram credential and type the manager's Chat ID in the approval node; pick an SMTP credential on both Email nodes; share the Form URL with your staff.",
      "formTitle": "Leave or expense request",
      "formDescription": "Your manager will approve or reject it, and you will get the answer by email.",
      "formFields": "[{\"label\":\"Name\",\"type\":\"text\",\"required\":true,\"options\":\"\"},{\"label\":\"Email\",\"type\":\"email\",\"required\":true,\"options\":\"\"},{\"label\":\"Type\",\"type\":\"dropdown\",\"required\":true,\"options\":\"Leave, Expense\"},{\"label\":\"Details\",\"type\":\"text\",\"required\":true,\"options\":\"\"},{\"label\":\"Dates or amount\",\"type\":\"text\",\"required\":true,\"options\":\"\"}]",
      "submitLabel": "Send request",
      "thankYouMessage": "Your request was sent to your manager.",
      "approvalTitle": "{{form.type}} request from {{form.name}}",
      "approvalMessage": "{{form.details}}\n{{form.dates_or_amount}}",
      "approvedSubject": "Your {{form.type}} request was approved",
      "approvedBody": "Hi {{form.name}},\n\nYour request was approved:\n{{form.details}}\n{{form.dates_or_amount}}",
      "rejectedSubject": "Your {{form.type}} request was not approved",
      "rejectedBody": "Hi {{form.name}},\n\nYour request was not approved. Please speak to your manager for details:\n{{form.details}}"
    }
  }
}
