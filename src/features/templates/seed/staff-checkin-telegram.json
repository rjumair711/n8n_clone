{
  "key": "staff_checkin_telegram",
  "category": "Telegram",
  "minPlan": "INTERMEDIATE",
  "nodes": [
    {
      "id": "trigger",
      "type": "TELEGRAM_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {}
    },
    {
      "id": "now",
      "type": "DATE_TIME",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "variableName": "now",
        "operation": "current",
        "timezone": "@text:timezone",
        "formatString": "YYYY-MM-DD HH:mm"
      }
    },
    {
      "id": "save",
      "type": "GOOGLE_SHEETS",
      "position": {
        "x": 640,
        "y": 0
      },
      "data": {
        "variableName": "attendance",
        "sheetId": "",
        "sheetName": "Sheet1",
        "rowData": "{{now.result}}, {{telegram.message.from.first_name}}, {{telegram.message.from.id}}, {{telegram.message.text}}"
      }
    },
    {
      "id": "done",
      "type": "TELEGRAM",
      "position": {
        "x": 960,
        "y": 0
      },
      "data": {
        "variableName": "checkinReply",
        "chatId": "{{telegram.message.chat.id}}",
        "text": "@text:savedMessage",
        "parseMode": "None"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "trigger",
      "toNodeId": "now",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "now",
      "toNodeId": "save",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "save",
      "toNodeId": "done",
      "fromOutput": "source-1",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "Staff check-in on Telegram",
      "description": "Staff send \"in\" or \"out\" (or a short note) to your Telegram bot and it is logged with the time and their name in a Google Sheet, so you have a simple attendance record. Set up: create a sheet with the columns Time, Name, Telegram ID, Message; pick credentials on the Telegram Trigger, Google Sheets (and Spreadsheet ID) and Telegram; change the time zone on the Date & Time node if needed; share the bot only with your staff.",
      "timezone": "Asia/Karachi",
      "savedMessage": "Recorded at {{now.result}}: {{telegram.message.text}}"
    }
  }
}
