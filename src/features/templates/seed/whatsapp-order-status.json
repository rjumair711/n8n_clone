{
  "key": "whatsapp_order_status",
  "category": "WhatsApp bots",
  "minPlan": "PRO",
  "nodes": [
    {
      "id": "trigger",
      "type": "WHATSAPP_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {}
    },
    {
      "id": "digits",
      "type": "TEXT_FORMATTER",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "variableName": "phoneDigits",
        "operation": "extract",
        "inputText": "{{whatsapp.from}}",
        "regexPattern": "\\d{10}$"
      }
    },
    {
      "id": "extract",
      "type": "INFORMATION_EXTRACTOR",
      "position": {
        "x": 640,
        "y": 0
      },
      "data": {
        "variableName": "request",
        "inputText": "{{whatsapp.text}}",
        "attributes": "orderNumber: the order number the customer wrote, digits only",
        "systemPrompt": "@text:extractPrompt"
      }
    },
    {
      "id": "model",
      "type": "GEMINI",
      "position": {
        "x": 640,
        "y": 260
      },
      "data": {
        "variableName": "chatModel"
      }
    },
    {
      "id": "find",
      "type": "WOOCOMMERCE",
      "position": {
        "x": 960,
        "y": 0
      },
      "data": {
        "variableName": "openOrder",
        "operation": "list_orders",
        "storeUrl": "",
        "search": "{{request.output.orderNumber}}",
        "limit": "1",
        "fields": "id, number, status, date_created, total, currency, billing"
      }
    },
    {
      "id": "match",
      "type": "IF",
      "position": {
        "x": 1280,
        "y": 0
      },
      "data": {
        "combinator": "and",
        "conditions": [
          {
            "inputKey": "openOrder.count",
            "operator": "greater_than",
            "value": "0"
          },
          {
            "inputKey": "openOrder.items.0.billing.phone",
            "operator": "contains",
            "value": "{{phoneDigits.result}}"
          }
        ]
      }
    },
    {
      "id": "compose",
      "type": "GEMINI",
      "position": {
        "x": 1600,
        "y": -120
      },
      "data": {
        "variableName": "statusReply",
        "systemPrompt": "@text:replyPrompt",
        "userPrompt": "Order {{openOrder.items.0.number}}: status {{openOrder.items.0.status}}, placed {{openOrder.items.0.date_created}}, total {{openOrder.items.0.total}} {{openOrder.items.0.currency}}.\nCustomer's message: {{whatsapp.text}}"
      }
    },
    {
      "id": "reply",
      "type": "WHATSAPP",
      "position": {
        "x": 1920,
        "y": -120
      },
      "data": {
        "variableName": "statusMessage",
        "operation": "send_text",
        "phoneNumberId": "{{whatsapp.phoneNumberId}}",
        "to": "{{whatsapp.from}}",
        "message": "{{statusReply.text}}"
      }
    },
    {
      "id": "notFound",
      "type": "WHATSAPP",
      "position": {
        "x": 1600,
        "y": 160
      },
      "data": {
        "variableName": "notFoundMessage",
        "operation": "send_text",
        "phoneNumberId": "{{whatsapp.phoneNumberId}}",
        "to": "{{whatsapp.from}}",
        "message": "@text:notFoundMessage"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "trigger",
      "toNodeId": "digits",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "digits",
      "toNodeId": "extract",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "model",
      "toNodeId": "extract",
      "fromOutput": "source-1",
      "toInput": "sub-model"
    },
    {
      "fromNodeId": "extract",
      "toNodeId": "find",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "find",
      "toNodeId": "match",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "match",
      "toNodeId": "compose",
      "fromOutput": "true",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "compose",
      "toNodeId": "reply",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "match",
      "toNodeId": "notFound",
      "fromOutput": "false",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "Order status on WhatsApp",
      "description": "Customers send their order number on WhatsApp and get the status back in their own language. Only the number that placed the order gets an answer, and only status, date and total are shared. Set up: put the Verify Token and App Secret on the WhatsApp Trigger; pick credentials on both Gemini nodes, the WooCommerce node (and its Store URL) and both WhatsApp nodes.",
      "extractPrompt": "You read WhatsApp messages sent to an online shop and find the order number in them.",
      "replyPrompt": "You are the order assistant of an online shop. Using only the order data given, tell the customer the status of their order in one or two short sentences, in the language of their message. Status words: pending = waiting for payment, processing = being prepared, on-hold = on hold, completed = delivered or shipped, cancelled = cancelled, refunded = refunded. Do not make up delivery dates.",
      "notFoundMessage": "Sorry, we could not find that order for this WhatsApp number. Please send the order number from your confirmation message, from the number you ordered with."
    }
  }
}
