{
  "key": "quote_request_with_approval",
  "category": "Forms",
  "minPlan": "FREE",
  "nodes": [
    {
      "id": "form",
      "type": "FORM_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "formTitle": "@text:formTitle",
        "formDescription": "@text:formDescription",
        "formFields": "@text:formFields",
        "submitLabel": "@text:submitLabel",
        "afterSubmit": "message",
        "thankYouMessage": "@text:thankYouMessage",
        "captcha": "true"
      }
    },
    {
      "id": "draft",
      "type": "GEMINI",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "variableName": "quote",
        "systemPrompt": "@text:systemPrompt",
        "userPrompt": "Customer: {{form.name}}\nRequest: {{form.what_do_you_need}}\nQuantity: {{form.quantity}}\nNeeded by: {{form.needed_by}}"
      }
    },
    {
      "id": "approve",
      "type": "APPROVAL",
      "position": {
        "x": 640,
        "y": 0
      },
      "data": {
        "variableName": "approval",
        "operation": "in_app",
        "title": "@text:approvalTitle",
        "message": "{{quote.text}}",
        "timeoutAmount": "2",
        "timeoutUnit": "days",
        "onTimeout": "reject"
      }
    },
    {
      "id": "send",
      "type": "EMAIL_SEND",
      "position": {
        "x": 960,
        "y": 0
      },
      "data": {
        "recipient": "{{form.email}}",
        "subject": "@text:emailSubject",
        "body": "{{quote.text}}"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "form",
      "toNodeId": "draft",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "draft",
      "toNodeId": "approve",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "approve",
      "toNodeId": "send",
      "fromOutput": "approved",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "Quote requests drafted by AI, sent after your approval",
      "description": "Customers ask for a price on a form; Gemini drafts a quote from your price list, you check it in RXJ (Approvals), and only approved quotes are emailed to the customer. Set up: replace the price list in Gemini's System Prompt with your own; pick a credential on Gemini and an SMTP credential on Email; share the Form URL on your website or WhatsApp.",
      "formTitle": "Request a quote",
      "formDescription": "Tell us what you need and we will email you a price.",
      "formFields": "[{\"label\":\"Name\",\"type\":\"text\",\"required\":true,\"options\":\"\"},{\"label\":\"Email\",\"type\":\"email\",\"required\":true,\"options\":\"\"},{\"label\":\"What do you need\",\"type\":\"text\",\"required\":true,\"options\":\"\"},{\"label\":\"Quantity\",\"type\":\"number\",\"required\":true,\"options\":\"\"},{\"label\":\"Needed by\",\"type\":\"date\",\"required\":false,\"options\":\"\"}]",
      "submitLabel": "Request quote",
      "thankYouMessage": "Thank you! We will email you a quote shortly.",
      "systemPrompt": "You write price quotes for a small business. From the customer's request and the price list below, write a short, clear quote in English: each item with quantity, unit price and line total, the grand total, delivery time and that the quote is valid for 7 days. Price list (replace with your own): business cards 2,500 per 500; flyers A5 6,000 per 1,000; banners 400 per square foot; delivery in 3 working days. If something is not on the list, write \"price on request\" for it. Do not invent discounts.",
      "approvalTitle": "Send this quote to {{form.name}} ({{form.email}})?",
      "emailSubject": "Your quote"
    }
  }
}
