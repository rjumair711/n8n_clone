{
  "key": "shopify_shipped_whatsapp",
  "category": "E-commerce",
  "minPlan": "FREE",
  "nodes": [
    {
      "id": "fulfilled",
      "type": "SHOPIFY_TRIGGER",
      "position": { "x": 0, "y": 0 },
      "data": { "event": "orders/fulfilled" }
    },
    {
      "id": "hasPhone",
      "type": "FILTER",
      "position": { "x": 300, "y": 0 },
      "data": { "inputKey": "shopify.phone", "operator": "exists", "value": "" }
    },
    {
      "id": "hasTracking",
      "type": "FILTER",
      "position": { "x": 600, "y": 0 },
      "data": { "inputKey": "shopify.order.fulfillments.0.tracking_url", "operator": "exists", "value": "" }
    },
    {
      "id": "notify",
      "type": "WHATSAPP",
      "position": { "x": 900, "y": 0 },
      "data": {
        "variableName": "shippedMessage",
        "operation": "send_template",
        "phoneNumberId": "",
        "to": "{{shopify.phone}}",
        "templateName": "order_shipped",
        "languageCode": "@text:languageCode",
        "templateParamsJson": "[{{json shopify.customerName}}, {{json shopify.order.name}}, {{json shopify.order.fulfillments.0.tracking_company}}, {{json shopify.order.fulfillments.0.tracking_url}}]"
      }
    }
  ],
  "connections": [
    { "fromNodeId": "fulfilled", "toNodeId": "hasPhone", "fromOutput": "source-1", "toInput": "target-1" },
    { "fromNodeId": "hasPhone", "toNodeId": "hasTracking", "fromOutput": "source-1", "toInput": "target-1" },
    { "fromNodeId": "hasTracking", "toNodeId": "notify", "fromOutput": "source-1", "toInput": "target-1" }
  ],
  "text": {
    "en": {
      "name": "Shopify order shipped: WhatsApp tracking update",
      "description": "When a Shopify order is fulfilled with a tracking link, the customer gets a WhatsApp message with their order number, the courier and the link. Orders without a phone number or tracking link are skipped. Set up: create and get approval for a WhatsApp template order_shipped with 4 variables (name, order, courier, tracking link); put your signing secret on the Shopify Trigger and create the Order fulfillment webhook in Shopify; pick your WhatsApp credential and type your Phone Number ID; customers' phone numbers must include the country code (+92...).",
      "languageCode": "en_US"
    }
  }
}
