{
  "key": "feedback_negative_alert",
  "category": "Forms",
  "minPlan": "FREE",
  "nodes": [
    {
      "id": "form",
      "type": "FORM_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "formTitle": "@text:formTitle",
        "formDescription": "@text:formDescription",
        "formFields": "@text:formFields",
        "submitLabel": "@text:submitLabel",
        "afterSubmit": "message",
        "thankYouMessage": "@text:thankYouMessage",
        "captcha": "true"
      }
    },
    {
      "id": "classify",
      "type": "TEXT_CLASSIFIER",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "variableName": "sentiment",
        "inputText": "Rating: {{form.rating}}/5\n{{form.comments}}",
        "categories": "negative: the customer is unhappy, complains or rates 1 or 2\npositive: the customer is happy or neutral",
        "systemPrompt": "@text:classifierPrompt"
      }
    },
    {
      "id": "model",
      "type": "GEMINI",
      "position": {
        "x": 320,
        "y": 260
      },
      "data": {
        "variableName": "chatModel"
      }
    },
    {
      "id": "alert",
      "type": "TELEGRAM",
      "position": {
        "x": 640,
        "y": 0
      },
      "data": {
        "variableName": "negativeAlert",
        "chatId": "",
        "text": "@text:alert",
        "parseMode": "None"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "form",
      "toNodeId": "classify",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "model",
      "toNodeId": "classify",
      "fromOutput": "source-1",
      "toInput": "sub-model"
    },
    {
      "fromNodeId": "classify",
      "toNodeId": "alert",
      "fromOutput": "category-negative",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "Customer feedback form with unhappy-customer alert",
      "description": "A feedback form for your shop, clinic or restaurant. When a customer is unhappy, you get a Telegram message straight away with their comment and phone number, so you can call them back the same day. Set up: pick a credential on Gemini; pick your Telegram credential and your Chat ID on the Telegram node; activate the workflow and share the Form URL (or print it as a QR code at the counter).",
      "formTitle": "How did we do?",
      "formDescription": "Your feedback helps us improve. It takes 30 seconds.",
      "formFields": "[{\"label\":\"Name\",\"type\":\"text\",\"required\":false,\"options\":\"\"},{\"label\":\"Phone\",\"type\":\"text\",\"required\":false,\"options\":\"\"},{\"label\":\"Rating\",\"type\":\"dropdown\",\"required\":true,\"options\":\"5, 4, 3, 2, 1\"},{\"label\":\"Comments\",\"type\":\"text\",\"required\":false,\"options\":\"\"}]",
      "submitLabel": "Send feedback",
      "thankYouMessage": "Thank you for your feedback!",
      "classifierPrompt": "You read customer feedback for a small business.",
      "alert": "Unhappy customer ({{form.rating}}/5): {{form.name}} {{form.phone}}\n{{form.comments}}"
    }
  }
}
