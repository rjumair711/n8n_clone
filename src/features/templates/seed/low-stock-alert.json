{
  "key": "low_stock_alert",
  "category": "E-commerce",
  "minPlan": "FREE",
  "nodes": [
    {
      "id": "product",
      "type": "SHOPIFY_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "event": "products/update"
      }
    },
    {
      "id": "variants",
      "type": "SPLIT_OUT",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "variableName": "variant",
        "inputPath": "shopify.product",
        "field": "variants",
        "include": "none"
      }
    },
    {
      "id": "low",
      "type": "IF",
      "position": {
        "x": 640,
        "y": 0
      },
      "data": {
        "combinator": "and",
        "conditions": [
          {
            "inputKey": "item.inventory_quantity",
            "operator": "less_than",
            "value": "5"
          }
        ]
      }
    },
    {
      "id": "alert",
      "type": "TELEGRAM",
      "position": {
        "x": 960,
        "y": 0
      },
      "data": {
        "variableName": "stockAlert",
        "chatId": "",
        "text": "@text:alert",
        "parseMode": "None"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "product",
      "toNodeId": "variants",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "variants",
      "toNodeId": "low",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "low",
      "toNodeId": "alert",
      "fromOutput": "true",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "Low stock alert on Telegram",
      "description": "When a Shopify product is updated and one of its variants has fewer than 5 in stock, you get a Telegram message with the product, variant and quantity, so you can reorder in time. You are alerted again each time a low product changes. Set up: put your signing secret on the Shopify Trigger and create the Product update webhook in Shopify; change 5 in the IF node to your own limit; pick your Telegram credential and Chat ID.",
      "alert": "Low stock: {{shopify.product.title}} ({{item.title}}): {{item.inventory_quantity}} left"
    }
  }
}
