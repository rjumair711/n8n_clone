{
  "key": "after_sale_review_request",
  "category": "E-commerce",
  "minPlan": "PRO",
  "nodes": [
    {
      "id": "fulfilled",
      "type": "SHOPIFY_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "event": "orders/fulfilled"
      }
    },
    {
      "id": "hasPhone",
      "type": "FILTER",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "inputKey": "shopify.phone",
        "operator": "exists",
        "value": ""
      }
    },
    {
      "id": "wait",
      "type": "WAIT",
      "position": {
        "x": 640,
        "y": 0
      },
      "data": {
        "variableName": "wait",
        "operation": "interval",
        "amount": "3",
        "unit": "days"
      }
    },
    {
      "id": "ask",
      "type": "WHATSAPP",
      "position": {
        "x": 960,
        "y": 0
      },
      "data": {
        "variableName": "reviewRequest",
        "operation": "send_template",
        "phoneNumberId": "",
        "to": "{{shopify.phone}}",
        "templateName": "review_request",
        "languageCode": "@text:languageCode",
        "templateParamsJson": "[{{json shopify.customerName}}, {{json shopify.order.name}}]"
      }
    },
    {
      "id": "reply",
      "type": "WHATSAPP_TRIGGER",
      "position": {
        "x": 0,
        "y": 320
      },
      "data": {}
    },
    {
      "id": "rating",
      "type": "TEXT_FORMATTER",
      "position": {
        "x": 320,
        "y": 320
      },
      "data": {
        "variableName": "rating",
        "operation": "extract",
        "inputText": "{{whatsapp.text}}",
        "regexPattern": "[1-5]"
      }
    },
    {
      "id": "low",
      "type": "IF",
      "position": {
        "x": 640,
        "y": 320
      },
      "data": {
        "combinator": "and",
        "conditions": [
          {
            "inputKey": "rating.result",
            "operator": "exists",
            "value": ""
          },
          {
            "inputKey": "rating.result",
            "operator": "less_than",
            "value": "4"
          }
        ]
      }
    },
    {
      "id": "alert",
      "type": "TELEGRAM",
      "position": {
        "x": 960,
        "y": 220
      },
      "data": {
        "variableName": "ownerAlert",
        "chatId": "",
        "text": "@text:ownerAlert",
        "parseMode": "None"
      }
    },
    {
      "id": "sorry",
      "type": "WHATSAPP",
      "position": {
        "x": 1280,
        "y": 220
      },
      "data": {
        "variableName": "sorryReply",
        "operation": "send_text",
        "phoneNumberId": "{{whatsapp.phoneNumberId}}",
        "to": "{{whatsapp.from}}",
        "message": "@text:sorryMessage"
      }
    },
    {
      "id": "thanks",
      "type": "WHATSAPP",
      "position": {
        "x": 960,
        "y": 440
      },
      "data": {
        "variableName": "thanksReply",
        "operation": "send_text",
        "phoneNumberId": "{{whatsapp.phoneNumberId}}",
        "to": "{{whatsapp.from}}",
        "message": "@text:thanksMessage"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "fulfilled",
      "toNodeId": "hasPhone",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "hasPhone",
      "toNodeId": "wait",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "wait",
      "toNodeId": "ask",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "reply",
      "toNodeId": "rating",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "rating",
      "toNodeId": "low",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "low",
      "toNodeId": "alert",
      "fromOutput": "true",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "alert",
      "toNodeId": "sorry",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "low",
      "toNodeId": "thanks",
      "fromOutput": "false",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "After-sale review request on WhatsApp",
      "description": "Three days after a Shopify order is fulfilled, asks the customer on WhatsApp to rate it from 1 to 5. A rating of 3 or lower alerts you on Telegram at once; a good rating gets a thank-you with your review link. Set up: create an approved WhatsApp template review_request with 2 variables (name, order); put your signing secret on the Shopify Trigger; pick credentials on WhatsApp (and your Phone Number ID) and Telegram (and your Chat ID); add your review link to the thank-you message.",
      "languageCode": "en_US",
      "ownerAlert": "Low rating ({{rating.result}}/5) from WhatsApp {{whatsapp.from}} ({{whatsapp.name}}): {{whatsapp.text}}",
      "sorryMessage": "We are sorry it was not better. Someone from our team will contact you today to make it right.",
      "thanksMessage": "Thank you for your feedback! If you have a minute, a review here helps us a lot: https://example.com/review"
    }
  }
}
