{
  "key": "booking_form_to_calendar",
  "category": "Forms",
  "minPlan": "FREE",
  "nodes": [
    {
      "id": "form",
      "type": "FORM_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "formTitle": "@text:formTitle",
        "formDescription": "@text:formDescription",
        "formFields": "@text:formFields",
        "submitLabel": "@text:submitLabel",
        "afterSubmit": "message",
        "thankYouMessage": "@text:thankYouMessage",
        "captcha": "true"
      }
    },
    {
      "id": "end",
      "type": "DATE_TIME",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "variableName": "endTime",
        "operation": "manipulate",
        "timezone": "@text:timezone",
        "inputDate": "@text:startTime",
        "action": "add",
        "amount": 30,
        "unit": "minutes"
      }
    },
    {
      "id": "event",
      "type": "GOOGLE_CALENDAR",
      "position": {
        "x": 640,
        "y": 0
      },
      "data": {
        "variableName": "booking",
        "operation": "create",
        "calendarId": "primary",
        "summary": "@text:eventTitle",
        "description": "{{form.phone}} {{form.email}}\n{{form.notes}}",
        "startTime": "@text:startTime",
        "endTime": "{{endTime.iso}}"
      }
    },
    {
      "id": "confirm",
      "type": "EMAIL_SEND",
      "position": {
        "x": 960,
        "y": 0
      },
      "data": {
        "recipient": "{{form.email}}",
        "subject": "@text:emailSubject",
        "body": "@text:emailBody"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "form",
      "toNodeId": "end",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "end",
      "toNodeId": "event",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "event",
      "toNodeId": "confirm",
      "fromOutput": "source-1",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "Booking form to Google Calendar",
      "description": "Customers pick a date and a time slot on a booking form; a 30-minute event goes into your Google Calendar and they get a confirmation email. It does not check whether a slot is already taken. Set up: change the time slots in the form to your own; pick your Google credential on Google Calendar; pick an SMTP credential on Email; check the +05:00 time offset in the start time (Pakistan); share the Form URL.",
      "formTitle": "Book an appointment",
      "formDescription": "Choose a day and a time. You will get a confirmation by email.",
      "formFields": "[{\"label\":\"Name\",\"type\":\"text\",\"required\":true,\"options\":\"\"},{\"label\":\"Email\",\"type\":\"email\",\"required\":true,\"options\":\"\"},{\"label\":\"Phone\",\"type\":\"text\",\"required\":true,\"options\":\"\"},{\"label\":\"Date\",\"type\":\"date\",\"required\":true,\"options\":\"\"},{\"label\":\"Time\",\"type\":\"dropdown\",\"required\":true,\"options\":\"10:00, 10:30, 11:00, 11:30, 12:00, 12:30, 14:00, 14:30, 15:00, 15:30, 16:00, 16:30, 17:00\"},{\"label\":\"Notes\",\"type\":\"text\",\"required\":false,\"options\":\"\"}]",
      "submitLabel": "Book",
      "thankYouMessage": "Thank you! Your booking is confirmed; check your email.",
      "timezone": "Asia/Karachi",
      "startTime": "{{form.date}}T{{form.time}}:00+05:00",
      "eventTitle": "Booking: {{form.name}}",
      "emailSubject": "Your booking on {{form.date}} at {{form.time}}",
      "emailBody": "Hi {{form.name}},\n\nYour booking is confirmed for {{form.date}} at {{form.time}}.\n\nTo change it, reply to this email or call 0300-0000000."
    }
  }
}
