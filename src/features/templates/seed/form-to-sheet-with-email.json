{
  "key": "form_to_sheet_with_email",
  "category": "Forms",
  "minPlan": "INTERMEDIATE",
  "nodes": [
    {
      "id": "form",
      "type": "FORM_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "formTitle": "@text:formTitle",
        "formDescription": "@text:formDescription",
        "formFields": "@text:formFields",
        "submitLabel": "@text:submitLabel",
        "afterSubmit": "message",
        "thankYouMessage": "@text:thankYouMessage",
        "captcha": "true"
      }
    },
    {
      "id": "save",
      "type": "GOOGLE_SHEETS",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "variableName": "savedRow",
        "operation": "append",
        "sheetId": "",
        "sheetName": "Sheet1",
        "rowData": "{{formMeta.submittedAt}}, {{form.name}}, {{form.email}}, {{form.phone}}, {{form.message}}"
      }
    },
    {
      "id": "confirm",
      "type": "GMAIL",
      "position": {
        "x": 640,
        "y": 0
      },
      "data": {
        "variableName": "confirmation",
        "operation": "send_email",
        "to": "{{form.email}}",
        "subject": "@text:emailSubject",
        "emailType": "text",
        "message": "@text:emailMessage"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "form",
      "toNodeId": "save",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "save",
      "toNodeId": "confirm",
      "fromOutput": "source-1",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "Contact form to Google Sheets with confirmation email",
      "description": "A hosted contact form: every submission becomes a row in your Google Sheet and the person gets a confirmation email from your Gmail. Set up: create a sheet with the columns Received, Name, Email, Phone, Message; pick your Google credential and Spreadsheet ID on Google Sheets and Gmail; change the form's texts if you like; activate the workflow and share the Form Trigger's Form URL.",
      "formTitle": "Contact us",
      "formDescription": "Leave your details and we will get back to you within one working day.",
      "formFields": "[{\"label\":\"Name\",\"type\":\"text\",\"required\":true,\"options\":\"\"},{\"label\":\"Email\",\"type\":\"email\",\"required\":true,\"options\":\"\"},{\"label\":\"Phone\",\"type\":\"text\",\"required\":false,\"options\":\"\"},{\"label\":\"Message\",\"type\":\"text\",\"required\":true,\"options\":\"\"}]",
      "submitLabel": "Send",
      "thankYouMessage": "Thank you! We received your message and emailed you a copy.",
      "emailSubject": "We received your message",
      "emailMessage": "Hi {{form.name}},\n\nThank you for contacting us. We received your message and will reply within one working day.\n\nYour message:\n{{form.message}}"
    }
  }
}
