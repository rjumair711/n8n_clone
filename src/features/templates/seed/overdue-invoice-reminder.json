{
  "key": "overdue_invoice_reminder",
  "category": "Reminders",
  "minPlan": "INTERMEDIATE",
  "nodes": [
    {
      "id": "schedule",
      "type": "SCHEDULE_TRIGGER",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "variableName": "scheduleTrigger",
        "cronExpression": "@text:cronExpression"
      }
    },
    {
      "id": "sheet",
      "type": "GOOGLE_DRIVE",
      "position": {
        "x": 320,
        "y": 0
      },
      "data": {
        "variableName": "invoiceSheet",
        "operation": "download_file",
        "fileId": ""
      }
    },
    {
      "id": "rows",
      "type": "EXTRACT_FROM_FILE",
      "position": {
        "x": 640,
        "y": 0
      },
      "data": {
        "variableName": "invoices",
        "operation": "csv",
        "file": "invoiceSheet.file",
        "header": "yes",
        "delimiter": "comma"
      }
    },
    {
      "id": "overdue",
      "type": "IF",
      "position": {
        "x": 960,
        "y": 0
      },
      "data": {
        "combinator": "and",
        "conditions": [
          {
            "inputKey": "item.status",
            "operator": "not_equals",
            "value": "paid"
          },
          {
            "inputKey": "item.days_overdue",
            "operator": "greater_than",
            "value": "0"
          }
        ]
      }
    },
    {
      "id": "tell",
      "type": "TELEGRAM",
      "position": {
        "x": 1280,
        "y": 0
      },
      "data": {
        "variableName": "overdueAlert",
        "chatId": "",
        "text": "@text:alert",
        "parseMode": "None"
      }
    }
  ],
  "connections": [
    {
      "fromNodeId": "schedule",
      "toNodeId": "sheet",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "sheet",
      "toNodeId": "rows",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "rows",
      "toNodeId": "overdue",
      "fromOutput": "source-1",
      "toInput": "target-1"
    },
    {
      "fromNodeId": "overdue",
      "toNodeId": "tell",
      "fromOutput": "true",
      "toInput": "target-1"
    }
  ],
  "text": {
    "en": {
      "name": "Overdue invoice reminder on Telegram",
      "description": "Every morning at 09:00 (Pakistan time), sends you one Telegram message for each unpaid invoice in your sheet that is past its due date. Sheet columns (first row): client, invoice, amount, due, status, days_overdue, where days_overdue is the formula =TODAY()-D2. Set up: pick your Google credential and the sheet on Google Drive; pick your Telegram credential and your Chat ID on the Telegram node; write paid in status when an invoice is paid.",
      "cronExpression": "0 4 * * *",
      "alert": "Overdue: {{item.client}}, invoice {{item.invoice}}, {{item.amount}}, due {{item.due}} ({{item.days_overdue}} days late)"
    }
  }
}
