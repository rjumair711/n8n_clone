# Settings for RXJ on your own server. Copy this file to .env in the same
# folder and fill it in: cp env.example .env
# The .env file holds secrets: never commit it or share it.
# Every variable the app understands is listed in README.md under
# "Environment variables".

# --- Required ----------------------------------------------------------

# Your domain, without https://. Its DNS A record must point at this server.
RXJ_DOMAIN=rxj.example.com

# Generate each of the next five with: openssl rand -hex 32
# Letters and digits only (the Postgres password goes into a URL).
POSTGRES_PASSWORD=
# Signs sign-in sessions
BETTER_AUTH_SECRET=
# Encrypts saved credentials. Keep a copy somewhere safe: without it the
# saved credentials cannot be read again.
ENCRYPTION_KEY=
# Shared by the app and its Inngest server
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Who may publish workflow templates, comma-separated
ADMIN_EMAILS=you@example.com

# --- Optional ----------------------------------------------------------

# Another image tag, e.g. a fixed version instead of latest
# RXJ_IMAGE=ghcr.io/rjumair711/rxj:latest

# Emails (verification, password reset) through Resend. Without it,
# sign-up works without email verification.
# RESEND_API_KEY=
# EMAIL_FROM=RXJ <rxj@example.com>

# Google and GitHub sign-in. Redirect URIs:
# https://<RXJ_DOMAIN>/api/auth/callback/google and .../github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Private addresses workflows may reach, e.g. Ollama on this server
# PRIVATE_NETWORK_ALLOWLIST=host.docker.internal:11434
